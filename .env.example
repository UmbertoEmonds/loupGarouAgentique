# Copier ce fichier en .env (non versionné, voir .gitignore) et remplir les
# vraies valeurs. Ne jamais commiter .env.

# Fournisseur principal : Groq. Clé gratuite sans carte bancaire sur
# https://console.groq.com/keys. Liste ordonnée de modèles, séparés par des
# virgules : chaque modèle a son propre quota, le suivant prend le relais.
# Vide = "qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b" par défaut.
GROQ_API_KEY=
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b

# Secours : OpenRouter, utilisé seulement quand tous les modèles Groq sont à
# quota. Modèles gratuits nommés explicitement (sans crédit : 50 requêtes par
# jour pour tout le compte), puis "openrouter/free" en dernier recours : ce
# routeur choisit un modèle gratuit au hasard (parfois chinois, le filtre de
# langue retire alors le message) mais répond même quand les Gemma sont à quota.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,openrouter/free

# --- Front Django (facultatif en local) ---
# DJANGO_DEBUG=1            # en local seulement
# DJANGO_SECRET_KEY=        # obligatoire en production
# DATABASE_URL=postgres://user:mdp@hote:5432/base  # vide = SQLite local (db.sqlite3)
# DJANGO_SUPERUSER_USERNAME=  # compte admin (/admin/) créé par `manage.py ensure_admin`
# DJANGO_SUPERUSER_PASSWORD=
# FAKE_AI=1                 # IA scriptée locale : tester l'interface sans clé OpenRouter
# HUMAN_TIMEOUT_S=75        # délai laissé à l'humain pour agir (60-90 s selon la spec)
# DEBATE_DURATION_S=180
# IDLE_ABANDON_S=30         # délai sans client connecté avant d'abandonner la partie (économise les jetons)
# PRIVACY_CONTACT_EMAIL=    # adresse affichée sur /confidentialite/ pour exercer ses droits RGPD
