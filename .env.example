# Copier ce fichier en .env (non versionné, voir .gitignore) et remplir les
# vraies valeurs. Ne jamais commiter .env.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# optionnel, plusieurs modèles de repli séparés par des virgules, essayés
# dans l'ordre ; "openrouter/free" en dernier recours route vers n'importe
# quel modèle gratuit disponible :
OPENROUTER_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free,openrouter/free
